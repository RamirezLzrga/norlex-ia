# ── Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_pon_aqui_tu_llave
GROQ_MODEL=openai/gpt-oss-120b

# ── SQL Server (mismo servidor que la app .NET) ────────────────────────
# Trusted_Connection (Windows Auth) exige ejecutar en la MISMA maquina que
# corre el servicio de SQL y con la misma identidad de Windows.
# En la nube (Render) no hay Windows Auth: usa NORLEX_DB_USER / PASSWORD y una
# ruta publica a la instancia. SERVER se pasa tal cual a ODBC, asi que admite
# "host\SQLEXPRESS,1433" (instancia remota) y "host,1433".
NORLEX_DB_SERVER=.\SQLEXPRESS
NORLEX_DB_NAME=BD_Fed
NORLEX_DB_DRIVER=ODBC Driver 18 for SQL Server
# Solo si no usas Windows Auth:
# NORLEX_DB_USER=
# NORLEX_DB_PASSWORD=
# Segundos de espera al abrir la conexion (la BD en la nube puede tardar)
NORLEX_DB_TIMEOUT=10
# Con el Driver 18 el cifrado viene activado. En una BD expuesta a internet
# deja cifrar (yes) aunque el certificado sea autofirmado (TRUST_CERT=yes).
NORLEX_DB_ENCRYPT=no
NORLEX_DB_TRUST_CERT=yes

# ── Seguridad ───────────────────────────────────────────────────────────
# Secreto COMPARTIDO con la app .NET. Debe coincidir con
# Norlex:Ia:SharedSecret en appsettings.Local.json
NORLEX_IA_SHARED_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Ventana de tolerancia de la firma, en segundos
NORLEX_IA_SIGNATURE_TTL=300
# Clave que la app .NET envia para considerar al visitante anonymous
NORLEX_IA_ALLOW_ANONYMOUS=true
# Activa la pagina de pruebas /demo y los endpoints /api/demo/*, que permiten
# pedir CUALQUIER rol sin firma HMAC. Dejalo en false fuera de tu maquina.
NORLEX_IA_DEMO=false

# ── Servidor ────────────────────────────────────────────────────────────
NORLEX_IA_HOST=127.0.0.1
NORLEX_IA_PORT=8099
# Origenes de .NET permitidos (CSV). En dev se acepta el de Swagger.
NORLEX_IA_CORS_ORIGINS=http://localhost:5129,http://localhost:5130

# ── Limites ─────────────────────────────────────────────────────────────
NORLEX_IA_MAX_MENSAJE=500
NORLEX_IA_MAX_HISTORIAL=8
NORLEX_IA_MAX_ITERACIONES=6
